# Server-only backend URL. Never put JWT, SMTP or database secrets in NEXT_PUBLIC_*.
# Development: frontend :3000 forwards /api to the Nest backend :3010.
API_BACKEND_URL=http://localhost:3010/api
FRONTEND_ORIGIN=http://localhost:3000
# Optional: when testing the managed LAN HTTPS stack, redirect development login to its gateway.
# DEV_LOGIN_GATEWAY_ORIGIN=https://192.168.81.178:3443
# Production: set FRONTEND_ORIGIN=https://careops.example.com and enable the trusted edge.
TRUSTED_EDGE_ENABLED=false
# Generate two DIFFERENT random secrets of at least 32 bytes; never NEXT_PUBLIC_*.
TRUSTED_EDGE_SECRET=
# Same value as Nest BFF_PROXY_SECRET, different from JWT_SECRET and edge secret.
BFF_PROXY_SECRET=
# Production over a remote network:
# API_BACKEND_URL=https://api.example.com/api
